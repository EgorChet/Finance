# Product API (Node) — what the Vue app talks to
PORT=3000
ANALYZER_URL=http://127.0.0.1:8001

# Supabase — used for local and production (same project is fine)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# Leave STORAGE unset (auto). Only set STORAGE=local for fully offline file storage.
# STORAGE=local

# Auth
AUTH_PASSWORD=your-shared-password
# Login names (required when auth is enabled) — comma-separated, first user then second
AUTH_LABELS=
# Or set separately:
AUTH_LABEL_EGOR=
AUTH_LABEL_JULIA=
AUTH_SECRET=random-long-string-for-token-signing

# Google Drive auto-ingest (Apps Script → POST /api/ingest with X-Ingest-Key)
# Generate: openssl rand -hex 32 — see tools/drive-ingest/README.md
INGEST_SECRET=

# Telegram assistant (Totoshka): X-Assistant-Key, limited to an allowlist of routes (api/src/assistantAuth.ts)
# Generate: openssl rand -hex 32
ASSISTANT_KEY=

# Optional: Claude's guess (English name + category + reason) when labelling merchants in Review.
# Without it Review still shows the translation, same-day charges and history.
ANTHROPIC_API_KEY=

# Cal sync (server-side). The phone button starts it. Set these on Render, not in git.
# CAL_CARD_LAST4 picks the card when the account has several.
CAL_USERNAME=
CAL_PASSWORD=
CAL_CARD_LAST4=

# Comma-separated browser origins allowed to call the API (your GitHub Pages URL)
ALLOWED_ORIGINS=https://your-user.github.io

# Vue (build-time)
VITE_API_URL=http://127.0.0.1:3000

# Kaspa portfolio shown in app header (USDT from MEXC KASUSDT ticker)
KAS_BALANCE=347078.071
# KAS_MEXC_SYMBOL=KASUSDT

# FinEx FXCN China ETF — NAV from api.finex-etf.ru (same as finex-etf.ru/calc/nav)
FXCN_LOTS=488
